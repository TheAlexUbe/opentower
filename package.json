{
  "name": "opentower",
  "version": "1.0.0",
  "description": "OpenTower: a free, open-source browser ATC simulator",
  "type": "module",
  "private": true,
  "license": "MIT",
  "homepage": "https://thealexube.github.io/opentower/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheAlexUbe/opentower.git"
  },
  "bugs": {
    "url": "https://github.com/TheAlexUbe/opentower/issues"
  },
  "keywords": [
    "atc",
    "air-traffic-control",
    "simulator",
    "aviation",
    "pwa",
    "vanilla-js",
    "game"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "python3 -m http.server 8080",
